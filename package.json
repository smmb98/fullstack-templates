{
  "name": "showcase",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm flows:check && pnpm contrast:check && pnpm knip",
    "e2e": "pnpm --filter @showcase/shop e2e",
    "e2e:summary": "node scripts/e2e-summary/index.mjs",
    "storybook": "pnpm --filter @showcase/shop storybook",
    "flows:gen": "node scripts/flows-gen/index.mjs",
    "flows:check": "node scripts/flows-check/index.mjs",
    "contrast:check": "node scripts/contrast-check/index.mjs",
    "reduce:plan": "node scripts/reduce-plan/index.mjs",
    "gen-placeholders": "node scripts/gen-placeholders/index.mjs",
    "contract:gen": "node scripts/contract-gen/index.mjs",
    "knip": "knip"
  }
}
