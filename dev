#!/usr/bin/env sh
# Entry point for every command. Never install tools on the host.
set -eu
cd "$(dirname "$0")"

cmd="${1:-}"
if [ $# -gt 0 ]; then shift; fi

case "$cmd" in
  up) docker compose up -d app storybook ;;
  down) docker compose down ;;
  shell) docker compose run --rm tools sh ;;
  e2e) docker compose run --rm --no-deps e2e pnpm --filter @showcase/shop e2e "$@" ;;
  "")
    echo "usage: ./dev <command> ..." >&2
    echo "  up | down | shell | e2e [args] | <any command inside tools>" >&2
    exit 2
    ;;
  *) docker compose run --rm tools "$cmd" "$@" ;;
esac
